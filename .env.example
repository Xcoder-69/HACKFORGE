# AgroMind AI Environment Variables Configuration
# Copy this file to .env for local development

# Supabase Cloud Database & Backend Configuration
# Obtain from your Supabase project settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Open-Meteo Weather API Base URL (Free public API, no key required)
VITE_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Application Environment & Offline Mode Settings
VITE_APP_ENV=development
VITE_ENABLE_OFFLINE_CACHE=true

# Firebase Real SMS Authentication (10,000 Free SMS/Month)
# Obtain from Firebase Console -> Project Settings -> General -> Web Apps
VITE_FIREBASE_API_KEY=AIzaSyDy_u2sknXu2Kc4BN2FlEn6YJAZyM7e01o
VITE_FIREBASE_AUTH_DOMAIN=studio-7654728390-57060.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=studio-7654728390-57060
VITE_FIREBASE_STORAGE_BUCKET=studio-7654728390-57060.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=294209817908
VITE_FIREBASE_APP_ID=1:294209817908:web:58eb9c027c8771a3c62961

# SECURITY NOTICE:
# Server-side secrets (GEMINI_API_KEY, Supabase Service Role Key) must NEVER be placed here.
# Configure GEMINI_API_KEY only in Supabase Edge Function Secrets:
#   npx supabase secrets set GEMINI_API_KEY="your-gemini-key"
