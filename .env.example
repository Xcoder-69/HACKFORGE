# AgroMind AI Environment Configuration
# Copy this file to .env and fill in your values

# ─── Frontend Variables (exposed to browser via VITE_ prefix) ─────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
VITE_APP_ENV=development
VITE_ENABLE_OFFLINE_CACHE=true

# Firebase Real SMS Authentication
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Backend-Only Secrets (NEVER prefixed with VITE_) ─────────────────
# These are only accessible on the server (Vite dev server plugin / Supabase Edge Functions).
# They are NEVER sent to the browser.
GEMINI_API_KEY=
MANDI_API_KEY=
